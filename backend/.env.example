# Which AI provider to use: ollama | groq | gemini
AI_PROVIDER=ollama

# Free keys (only needed for groq or gemini):
GROQ_API_KEY=         # https://console.groq.com/keys
GEMINI_API_KEY=       # https://aistudio.google.com/apikey
# Ollama needs no key: install https://ollama.com, then `ollama pull llama3.2`
# OLLAMA_URL=http://localhost:11434

# Optional: comma-separated models to try in order (overrides the provider defaults)
# AI_MODELS=llama3.2
